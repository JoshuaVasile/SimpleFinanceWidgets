<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DXY Intraday High/Low</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #111827; /* Dark background for better contrast on a display */
        }
        .data-card {
            background-color: #1F2937;
            border-radius: 0.75rem;
            padding: 2rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border: 1px solid #374151;
        }
    </style>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center min-h-screen">

    <div id="container" class="w-full max-w-sm mx-auto p-4">
        <div class="data-card">
            <div class="flex justify-between items-center mb-4">
                <h1 class="text-2xl font-bold text-gray-200"</h1>
                <span id="status-indicator" class="w-3 h-3 rounded-full bg-yellow-500" title="Updating..."></span>
            </div>

            <!-- Loading Skeleton -->
            <div id="loading" class="space-y-4">
                <div class="h-8 bg-gray-700 rounded-md animate-pulse"></div>
                <div class="h-8 bg-gray-700 rounded-md animate-pulse"></div>
            </div>

            <!-- Data Display -->
            <div id="data-display" class="hidden space-y-2">
                <div class="flex justify-between items-baseline">
                    <span class="text-lg font-medium text-gray-400">Current:</span>
                    <span id="dxy-current" class="text-3xl font-bold text-blue-400">--.--</span>
                </div>
                <div class="flex justify-between items-baseline">
                    <span class="text-lg font-medium text-gray-400">Prev. Close:</span>
                    <span id="dxy-prev-close" class="text-3xl font-bold text-gray-500">--.--</span>
                </div>
                 <div class="text-xs text-gray-500 pt-4 text-right">
                    Last updated: <span id="last-updated">never</span>
                </div>
            </div>

             <!-- Error Message -->
            <div id="error-message" class="hidden text-center text-red-400 bg-red-900/50 p-3 rounded-lg">
                <p>Could not fetch data. Please check your API key or network connection.</p>
                <p class="text-xs text-gray-500 mt-2">Will retry shortly.</p>
            </div>
        </div>
    </div>

    <script>
        // Using the first API key: Twelve Data
        const API_KEY = "Twelve Data KEY";
        const REFRESH_INTERVAL_MS = 60 * 60 * 1000; // 1 hour

        // --- DXY CALCULATION SETUP ---
        const dxyComponents = {
            // Twelve Data uses the standard 'EUR/USD' format
            'EURUSD': { weight: -0.576, symbol: 'EUR/USD' },
            'USDJPY': { weight: 0.136,  symbol: 'USD/JPY' },
            'GBPUSD': { weight: -0.119, symbol: 'GBP/USD' },
            'USDCAD': { weight: 0.091,  symbol: 'USD/CAD' },
            'USDSEK': { weight: 0.042,  symbol: 'USD/SEK' },
            'USDCHF': { weight: 0.036,  symbol: 'USD/CHF' },
        };
        const DXY_CONSTANT = 50.14348112;
        
        // DOM elements
        const currentElement = document.getElementById('dxy-current');
        const prevCloseElement = document.getElementById('dxy-prev-close');
        const lastUpdatedElement = document.getElementById('last-updated');
        const statusIndicator = document.getElementById('status-indicator');
        const loadingSkeleton = document.getElementById('loading');
        const dataDisplay = document.getElementById('data-display');
        const errorMessageElement = document.getElementById('error-message');

        async function fetchDxyData() {
             if (API_KEY === "YOUR_API_KEY") {
                handleFetchError('API Key is missing.');
                return;
            }
            
            console.log(`Fetching DXY component data from Twelve Data...`);
            statusIndicator.classList.remove('bg-green-500', 'bg-red-500');
            statusIndicator.classList.add('bg-yellow-500');
            errorMessageElement.classList.add('hidden');

            try {
                const componentSymbols = Object.values(dxyComponents).map(c => c.symbol);
                const promises = componentSymbols.map(symbol => 
                    fetch(`https://api.twelvedata.com/quote?symbol=${symbol}&apikey=${API_KEY}`)
                    .then(res => res.json())
                );

                const results = await Promise.all(promises);
                
                const quotes = {};
                for(let i = 0; i < results.length; i++) {
                    const symbol = componentSymbols[i];
                    const data = results[i];
                    if (data.status === 'error' || !data.close) {
                        throw new Error(`No data for component ${symbol}. ${data.message || ''}`);
                    }
                    quotes[symbol] = data;
                }
                
                calculateAndDisplayDXY(quotes);

            } catch (error) {
                console.error("Failed to fetch DXY data:", error);
                handleFetchError(error.message);
            }
        }
        
        function calculateAndDisplayDXY(quotes) {
            let currentProduct = 1;
            let prevCloseProduct = 1;

            for (const component of Object.values(dxyComponents)) {
                const quote = quotes[component.symbol];
                // Twelve Data uses 'close' and 'previous_close'
                currentProduct *= Math.pow(parseFloat(quote.close), component.weight);
                prevCloseProduct *= Math.pow(parseFloat(quote.previous_close), component.weight);
            }

            const dxyCurrent = (currentProduct * DXY_CONSTANT).toFixed(2);
            const dxyPrevClose = (prevCloseProduct * DXY_CONSTANT).toFixed(2);
            
            updateDisplay(dxyCurrent, dxyPrevClose);
        }

        function updateDisplay(current, prevClose) {
            loadingSkeleton.classList.add('hidden');
            dataDisplay.classList.remove('hidden');
            
            currentElement.textContent = current;
            prevCloseElement.textContent = prevClose;
            
            if (current > prevClose) {
                currentElement.classList.remove('text-red-400', 'text-blue-400');
                currentElement.classList.add('text-green-400');
            } else if (current < prevClose) {
                currentElement.classList.remove('text-green-400', 'text-blue-400');
                currentElement.classList.add('text-red-400');
            }

            lastUpdatedElement.textContent = new Date().toLocaleTimeString();
            statusIndicator.classList.remove('bg-yellow-500', 'bg-red-500');
            statusIndicator.classList.add('bg-green-500');
            statusIndicator.title = `Last updated: ${new Date().toLocaleString()}`;
        }

        function handleFetchError(message = "Could not fetch data.") {
            loadingSkeleton.classList.add('hidden');
            dataDisplay.classList.add('hidden');
            errorMessageElement.querySelector('p').textContent = message;
            errorMessageElement.classList.remove('hidden');
            statusIndicator.classList.remove('bg-green-500', 'bg-yellow-500');
            statusIndicator.classList.add('bg-red-500');
            statusIndicator.title = 'Failed to fetch data';
        }

        document.addEventListener('DOMContentLoaded', () => {
            fetchDxyData();
            setInterval(fetchDxyData, REFRESH_INTERVAL_MS);
        });
    </script>
</body>
</html>
